{
  "version": "1.4.0",
  "description": "Inner Dialogue updatable components",
  "base_url": "https://raw.githubusercontent.com/ataglianetti/inner-dialogue/main/",
  "components": {
    "safety-protocol": {
      "file": "safety-protocol.md",
      "target": ".therapy/safety-protocol.md",
      "required": true,
      "description": "Crisis protocols and safety guidelines"
    },
    "commands": {
      "file": "commands.md",
      "target": ".therapy/commands.md",
      "required": true,
      "description": "Customization commands (import, update, persona, etc.)"
    },
    "profile-protocol": {
      "file": "profile-protocol.md",
      "target": ".therapy/profile-protocol.md",
      "required": true,
      "description": "Profile provenance rules: date-stamped writes + staleness review ritual. Read at session start (new installs via CLAUDE.md; existing installs via the commands.md pointer)."
    },
    "safety-net": {
      "file": "hooks/safety-net.js",
      "target": ".therapy/hooks/safety-net.js",
      "required": true,
      "description": "Mechanical crisis-language backstop hook (English-only pattern matcher). Injects the safety-protocol reminder when a prompt matches crisis language; the prose safety protocol remains authoritative."
    },
    "claude-settings": {
      "file": "claude-settings.template.json",
      "target": ".claude/settings.json",
      "required": false,
      "scaffold_only": true,
      "description": "Claude Code hooks for the therapist install. Registers two UserPromptSubmit hooks: the current-local-time hook and the safety-net crisis-language backstop hook. Scaffolded on install/update; never overwritten."
    },
    "context-index": {
      "file": "context/index.template.md",
      "target": "context/index.md",
      "required": false,
      "scaffold_only": true,
      "description": "Routing index for the subject-level context library (people, places, concepts, events). Scaffolded on install/update; never overwritten."
    }
  },
  "library": {
    "personas": {
      "target": ".therapy/library/personas/",
      "description": "Communication style options",
      "files": [
        "personas/warm-4o.md",
        "personas/direct-challenging.md",
        "personas/warm-supportive.md",
        "personas/coach.md",
        "personas/grounded-real.md",
        "personas/contemplative.md",
        "personas/philosophical.md",
        "personas/creative.md"
      ]
    },
    "modalities": {
      "target": ".therapy/library/modalities/",
      "description": "Therapeutic approach options",
      "files": [
        "modalities/cbt.md",
        "modalities/act.md",
        "modalities/cft.md",
        "modalities/dbt-skills.md",
        "modalities/ifs.md",
        "modalities/lifespan-integration.md",
        "modalities/motivational-interviewing.md",
        "modalities/narrative.md",
        "modalities/polyvagal.md",
        "modalities/psychodynamic.md",
        "modalities/sfbt.md",
        "modalities/somatic-experiencing.md",
        "modalities/ideal-parent-figure.md"
      ]
    },
    "structures": {
      "target": ".therapy/library/structures/",
      "description": "Session structure options",
      "files": [
        "structures/structured.md",
        "structures/moderate.md",
        "structures/freeform.md"
      ]
    }
  }
}
